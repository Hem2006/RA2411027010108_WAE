<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_A1" targetNamespace="http://example.org/bpmn/assignment">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_P1" name="Student Project Approval &amp; Allocation" processRef="Process_P1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P1" name="Student Project Approval &amp; Allocation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P1">
      <bpmn:lane id="Lane_stu" name="Student / Team">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_dl</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_sy" name="Project Management System">
        <bpmn:flowNodeRef>T_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_sim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_rule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_alloc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_note</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_flag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_late</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_co" name="Project Coordinator">
        <bpmn:flowNodeRef>T_scr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_rev</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_cm" name="Review Committee (incl. HoD)">
        <bpmn:flowNodeRef>T_eval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>X_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_rem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_rem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_rem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_rej</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_gd" name="Faculty Guide">
        <bpmn:flowNodeRef>T_acc</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Team decides to submit a proposal">
      <bpmn:outgoing>Flow_001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_sub" name="Submit project proposal">
      <bpmn:incoming>Flow_001</bpmn:incoming>
      <bpmn:outgoing>Flow_002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_val" name="Validate form &amp; team rules">
      <bpmn:incoming>Flow_002</bpmn:incoming>
      <bpmn:outgoing>Flow_003</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="X_val" name="Valid?" default="Flow_004">
      <bpmn:incoming>Flow_003</bpmn:incoming>
      <bpmn:outgoing>Flow_004</bpmn:outgoing>
      <bpmn:outgoing>Flow_005</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_scr" name="Screen proposal">
      <bpmn:incoming>Flow_004</bpmn:incoming>
      <bpmn:outgoing>Flow_007</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_sim" name="Run similarity check">
      <bpmn:incoming>Flow_007</bpmn:incoming>
      <bpmn:outgoing>Flow_008</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_eval" name="Evaluate proposal">
      <bpmn:incoming>Flow_008</bpmn:incoming>
      <bpmn:outgoing>Flow_009</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="X_dec" name="Committee decision?" default="Flow_012">
      <bpmn:incoming>Flow_009</bpmn:incoming>
      <bpmn:outgoing>Flow_010</bpmn:outgoing>
      <bpmn:outgoing>Flow_011</bpmn:outgoing>
      <bpmn:outgoing>Flow_012</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="T_rule" name="Check guide availability &amp; workload">
      <bpmn:incoming>Flow_010</bpmn:incoming>
      <bpmn:outgoing>Flow_017</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="T_alloc" name="Allocate guide">
      <bpmn:incoming>Flow_017</bpmn:incoming>
      <bpmn:outgoing>Flow_018</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T_req" name="Send allocation request">
      <bpmn:incoming>Flow_018</bpmn:incoming>
      <bpmn:outgoing>Flow_019</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="T_acc" name="Guide accepts request">
      <bpmn:incoming>Flow_019</bpmn:incoming>
      <bpmn:outgoing>Flow_020</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="T_note" name="Notify student">
      <bpmn:incoming>Flow_020</bpmn:incoming>
      <bpmn:outgoing>Flow_021</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="T_rec" name="Record allocation">
      <bpmn:incoming>Flow_021</bpmn:incoming>
      <bpmn:outgoing>Flow_022</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_end" name="Project allocated">
      <bpmn:incoming>Flow_022</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="T_ret" name="Return proposal with error list">
      <bpmn:incoming>Flow_005</bpmn:incoming>
      <bpmn:outgoing>Flow_006</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_ret" name="Returned to student">
      <bpmn:incoming>Flow_006</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="B_dl" name="Deadline missed" attachedToRef="T_sub">
      <bpmn:outgoing>Flow_013</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDate xsi:type="bpmn:tFormalExpression">${deadline}</bpmn:timeDate></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="T_flag" name="Flag team as late &amp; notify">
      <bpmn:incoming>Flow_013</bpmn:incoming>
      <bpmn:outgoing>Flow_014</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_late" name="Late request to coordinator">
      <bpmn:incoming>Flow_014</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="B_rem" name="No decision in 7 days" attachedToRef="T_eval" cancelActivity="false">
      <bpmn:outgoing>Flow_015</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="T_rem" name="Send reminder to committee">
      <bpmn:incoming>Flow_015</bpmn:incoming>
      <bpmn:outgoing>Flow_016</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_rem" name="Reminder sent">
      <bpmn:incoming>Flow_016</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E_rev" name="Sent back for revision">
      <bpmn:incoming>Flow_011</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E_rej" name="Proposal rejected">
      <bpmn:incoming>Flow_012</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_001" sourceRef="S1" targetRef="T_sub" />
    <bpmn:sequenceFlow id="Flow_002" sourceRef="T_sub" targetRef="T_val" />
    <bpmn:sequenceFlow id="Flow_003" sourceRef="T_val" targetRef="X_val" />
    <bpmn:sequenceFlow id="Flow_004" name="Yes" sourceRef="X_val" targetRef="T_scr" />
    <bpmn:sequenceFlow id="Flow_005" name="No" sourceRef="X_val" targetRef="T_ret">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">valid == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_006" sourceRef="T_ret" targetRef="E_ret" />
    <bpmn:sequenceFlow id="Flow_007" sourceRef="T_scr" targetRef="T_sim" />
    <bpmn:sequenceFlow id="Flow_008" sourceRef="T_sim" targetRef="T_eval" />
    <bpmn:sequenceFlow id="Flow_009" sourceRef="T_eval" targetRef="X_dec" />
    <bpmn:sequenceFlow id="Flow_010" name="Approved" sourceRef="X_dec" targetRef="T_rule">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision == 'approved'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_011" name="Revise" sourceRef="X_dec" targetRef="E_rev">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision == 'revise'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_012" name="Rejected" sourceRef="X_dec" targetRef="E_rej" />
    <bpmn:sequenceFlow id="Flow_013" sourceRef="B_dl" targetRef="T_flag" />
    <bpmn:sequenceFlow id="Flow_014" sourceRef="T_flag" targetRef="E_late" />
    <bpmn:sequenceFlow id="Flow_015" sourceRef="B_rem" targetRef="T_rem" />
    <bpmn:sequenceFlow id="Flow_016" sourceRef="T_rem" targetRef="E_rem" />
    <bpmn:sequenceFlow id="Flow_017" sourceRef="T_rule" targetRef="T_alloc" />
    <bpmn:sequenceFlow id="Flow_018" sourceRef="T_alloc" targetRef="T_req" />
    <bpmn:sequenceFlow id="Flow_019" sourceRef="T_req" targetRef="T_acc" />
    <bpmn:sequenceFlow id="Flow_020" sourceRef="T_acc" targetRef="T_note" />
    <bpmn:sequenceFlow id="Flow_021" sourceRef="T_note" targetRef="T_rec" />
    <bpmn:sequenceFlow id="Flow_022" sourceRef="T_rec" targetRef="E_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
