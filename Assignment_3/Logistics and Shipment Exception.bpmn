<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_A2" targetNamespace="http://example.org/bpmn/assignment">
  <bpmn:error id="Err_Damage" name="Parcel damaged" errorCode="PARCEL_DAMAGED" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_P2" name="Shipment Life Cycle" processRef="Process_P2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P2" name="Shipment Life Cycle" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P2">
      <bpmn:lane id="Lane_shp" name="Shipper / Customer">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_book</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ct" name="Control Tower / Dispatcher">
        <bpmn:flowNodeRef>T_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_sch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_trk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ntf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_c</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_pk" name="Pickup Agent">
        <bpmn:flowNodeRef>T_pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_pk</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_hb" name="Hub / Warehouse">
        <bpmn:flowNodeRef>G_sp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_tr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_jn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_dmg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_cl" name="Claims Department">
        <bpmn:flowNodeRef>T_claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_cl</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_da" name="Delivery Agent">
        <bpmn:flowNodeRef>T_out</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_pod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_r</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_rc" name="Recipient">
        <bpmn:flowNodeRef>X_av</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Shipper books a shipment">
      <bpmn:outgoing>Flow_001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_book" name="Create shipment booking">
      <bpmn:incoming>Flow_001</bpmn:incoming>
      <bpmn:outgoing>Flow_002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="T_val" name="Validate booking &amp; calculate charges">
      <bpmn:incoming>Flow_002</bpmn:incoming>
      <bpmn:outgoing>Flow_003</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="T_sch" name="Schedule pickup &amp; assign driver">
      <bpmn:incoming>Flow_003</bpmn:incoming>
      <bpmn:outgoing>Flow_004</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_pick" name="Collect parcel &amp; scan it">
      <bpmn:incoming>Flow_004</bpmn:incoming>
      <bpmn:outgoing>Flow_005</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="G_sp">
      <bpmn:incoming>Flow_005</bpmn:incoming>
      <bpmn:outgoing>Flow_006</bpmn:outgoing>
      <bpmn:outgoing>Flow_007</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="T_trk" name="Update tracking">
      <bpmn:incoming>Flow_007</bpmn:incoming>
      <bpmn:outgoing>Flow_008</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T_ntf" name="Notify shipper">
      <bpmn:incoming>Flow_008</bpmn:incoming>
      <bpmn:outgoing>Flow_013</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:subProcess id="SP_tr" name="Hub sorting &amp; line-haul (per leg)">
      <bpmn:incoming>Flow_006</bpmn:incoming>
      <bpmn:outgoing>Flow_012</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
      <bpmn:startEvent id="S_t" name="Leg starts">
        <bpmn:outgoing>Flow_009</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:manualTask id="T_sort" name="Sort parcel at hub">
        <bpmn:incoming>Flow_009</bpmn:incoming>
        <bpmn:outgoing>Flow_010</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:manualTask id="T_haul" name="Line-haul to destination hub">
        <bpmn:incoming>Flow_010</bpmn:incoming>
        <bpmn:outgoing>Flow_011</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:endEvent id="E_t" name="Leg done">
        <bpmn:incoming>Flow_011</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_009" sourceRef="S_t" targetRef="T_sort" />
      <bpmn:sequenceFlow id="Flow_010" sourceRef="T_sort" targetRef="T_haul" />
      <bpmn:sequenceFlow id="Flow_011" sourceRef="T_haul" targetRef="E_t" />
    </bpmn:subProcess>
    <bpmn:parallelGateway id="G_jn">
      <bpmn:incoming>Flow_012</bpmn:incoming>
      <bpmn:incoming>Flow_013</bpmn:incoming>
      <bpmn:outgoing>Flow_014</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="T_out" name="Dispatch &amp; notify recipient">
      <bpmn:incoming>Flow_014</bpmn:incoming>
      <bpmn:outgoing>Flow_015</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="X_av" name="Recipient available?" default="Flow_016">
      <bpmn:incoming>Flow_015</bpmn:incoming>
      <bpmn:outgoing>Flow_016</bpmn:outgoing>
      <bpmn:outgoing>Flow_017</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_pod" name="Hand over parcel &amp; capture proof of delivery">
      <bpmn:incoming>Flow_016</bpmn:incoming>
      <bpmn:outgoing>Flow_019</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_close" name="Close shipment &amp; generate invoice">
      <bpmn:incoming>Flow_019</bpmn:incoming>
      <bpmn:outgoing>Flow_020</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_ok" name="Shipment delivered">
      <bpmn:incoming>Flow_020</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="B_pk" name="Shipper absent" attachedToRef="T_pick">
      <bpmn:outgoing>Flow_021</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="T_cancel" name="Cancel booking &amp; charge fee">
      <bpmn:incoming>Flow_021</bpmn:incoming>
      <bpmn:outgoing>Flow_022</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_c" name="Booking cancelled">
      <bpmn:incoming>Flow_022</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="B_dmg" name="Damage found" attachedToRef="SP_tr">
      <bpmn:outgoing>Flow_023</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Err_Damage" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="T_claim" name="Handle damage claim">
      <bpmn:incoming>Flow_023</bpmn:incoming>
      <bpmn:outgoing>Flow_024</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_cl" name="Claim raised">
      <bpmn:incoming>Flow_024</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="T_ret" name="Return parcel to sender">
      <bpmn:incoming>Flow_017</bpmn:incoming>
      <bpmn:outgoing>Flow_018</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="E_r" name="Returned to sender">
      <bpmn:incoming>Flow_018</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_001" sourceRef="S1" targetRef="T_book" />
    <bpmn:sequenceFlow id="Flow_002" sourceRef="T_book" targetRef="T_val" />
    <bpmn:sequenceFlow id="Flow_003" sourceRef="T_val" targetRef="T_sch" />
    <bpmn:sequenceFlow id="Flow_004" sourceRef="T_sch" targetRef="T_pick" />
    <bpmn:sequenceFlow id="Flow_005" sourceRef="T_pick" targetRef="G_sp" />
    <bpmn:sequenceFlow id="Flow_006" sourceRef="G_sp" targetRef="SP_tr" />
    <bpmn:sequenceFlow id="Flow_007" sourceRef="G_sp" targetRef="T_trk" />
    <bpmn:sequenceFlow id="Flow_008" sourceRef="T_trk" targetRef="T_ntf" />
    <bpmn:sequenceFlow id="Flow_012" sourceRef="SP_tr" targetRef="G_jn" />
    <bpmn:sequenceFlow id="Flow_013" sourceRef="T_ntf" targetRef="G_jn" />
    <bpmn:sequenceFlow id="Flow_014" sourceRef="G_jn" targetRef="T_out" />
    <bpmn:sequenceFlow id="Flow_015" sourceRef="T_out" targetRef="X_av" />
    <bpmn:sequenceFlow id="Flow_016" name="Yes" sourceRef="X_av" targetRef="T_pod" />
    <bpmn:sequenceFlow id="Flow_017" name="No" sourceRef="X_av" targetRef="T_ret">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">absent == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_018" sourceRef="T_ret" targetRef="E_r" />
    <bpmn:sequenceFlow id="Flow_019" sourceRef="T_pod" targetRef="T_close" />
    <bpmn:sequenceFlow id="Flow_020" sourceRef="T_close" targetRef="E_ok" />
    <bpmn:sequenceFlow id="Flow_021" sourceRef="B_pk" targetRef="T_cancel" />
    <bpmn:sequenceFlow id="Flow_022" sourceRef="T_cancel" targetRef="E_c" />
    <bpmn:sequenceFlow id="Flow_023" sourceRef="B_dmg" targetRef="T_claim" />
    <bpmn:sequenceFlow id="Flow_024" sourceRef="T_claim" targetRef="E_cl" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
