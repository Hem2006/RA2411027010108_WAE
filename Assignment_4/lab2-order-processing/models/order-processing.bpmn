<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_OrderProcessing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="order-processing-process" name="Lab 2 - E-Commerce Order Processing" isExecutable="true">
    <bpmn:documentation>Validate order, check simulated inventory, calculate total (job workers), determine priority (DMN), manual verification of high-value orders (user task), mock payment (REST connector), fulfilment and customer notification (job workers).</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order received">
      <bpmn:outgoing>Flow_ToValidate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ValidateOrder" name="Validate order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lab2-validate-order" retries="2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToValidGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Order valid?" default="Flow_Invalid">
      <bpmn:incoming>Flow_ToValidGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CheckInventory" name="Check inventory">
      <bpmn:documentation>Job worker calls the simulated inventory service. If the service is down the job fails, retries are used up and an incident is raised.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lab2-check-inventory" retries="2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToStockGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Stock" name="In stock?" default="Flow_OutOfStock">
      <bpmn:incoming>Flow_ToStockGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_InStock</bpmn:outgoing>
      <bpmn:outgoing>Flow_OutOfStock</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CalculateTotal" name="Calculate order total">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lab2-calculate-total" retries="2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_InStock</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPriority</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_DeterminePriority" name="Determine order priority (DMN)">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="order-priority-decision" resultVariable="priorityResult" />
        <zeebe:ioMapping>
          <zeebe:output source="=priorityResult" target="priorityResult" />
          <zeebe:output source="=priorityResult.deliveryPriority" target="deliveryPriority" />
          <zeebe:output source="=priorityResult.manualVerificationRequired" target="manualVerificationRequired" />
          <zeebe:output source="=priorityResult.priorityReason" target="priorityReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPriority</bpmn:incoming>
      <bpmn:outgoing>Flow_ToVerifyGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_NeedsVerification" name="Manual verification required?" default="Flow_NoVerification">
      <bpmn:incoming>Flow_ToVerifyGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_NeedsVerification</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoVerification</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_VerifyOrder" name="Verify high-value order">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="order-verification-form" />
        <zeebe:assignmentDefinition candidateGroups="order-verification-team" />
        <zeebe:priorityDefinition priority="70" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NeedsVerification</bpmn:incoming>
      <bpmn:outgoing>Flow_ToVerifiedGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Verified" name="Verified?" default="Flow_VerificationRejected">
      <bpmn:incoming>Flow_ToVerifiedGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_VerificationApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_VerificationRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_JoinPayment">
      <bpmn:incoming>Flow_NoVerification</bpmn:incoming>
      <bpmn:incoming>Flow_VerificationApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPayment</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ProcessPayment" name="Process payment (REST)" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="11">
      <bpmn:documentation>REST Connector calling the mock payment service with a test token. A declined payment is a normal 200 response (status DECLINED). HTTP 5xx is a technical failure: the connector retries 3 times, then raises an incident.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="{{secrets.LAB2_MOCK_API_URL}}/api/payments" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;: &#34;application/json&#34;, &#34;Idempotency-Key&#34;: orderId}" target="headers" />
          <zeebe:input source="false" target="storeResponse" />
          <zeebe:input source="10" target="connectionTimeoutInSeconds" />
          <zeebe:input source="10" target="readTimeoutInSeconds" />
          <zeebe:input source="={orderId: orderId, customerRef: customerRef, amount: orderTotal, currency: currency, paymentToken: paymentToken}" target="body" />
          <zeebe:input source="false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="11" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={paymentId: response.body.paymentId, paymentStatus: response.body.status, paymentDeclineReason: response.body.declineReason}" />
          <zeebe:header key="retryBackoff" value="PT10S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPayment</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPaymentGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Payment" name="Payment approved?" default="Flow_PaymentDeclined">
      <bpmn:incoming>Flow_ToPaymentGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentDeclined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ArrangeFulfilment" name="Arrange fulfilment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lab2-arrange-fulfilment" retries="2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PaymentApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_FulfilmentToMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeNotify">
      <bpmn:incoming>Flow_FulfilmentToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_PaymentDeclined</bpmn:incoming>
      <bpmn:incoming>Flow_VerificationRejected</bpmn:incoming>
      <bpmn:incoming>Flow_OutOfStock</bpmn:incoming>
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNotify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NotifyCustomer" name="Notify customer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lab2-notify-customer" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFinalGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Final" name="Order status?" default="Flow_NotFulfilled">
      <bpmn:incoming>Flow_ToFinalGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Fulfilled</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotFulfilled</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Fulfilled" name="Order sent to fulfilment">
      <bpmn:incoming>Flow_Fulfilled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_NotFulfilled" name="Order not fulfilled">
      <bpmn:incoming>Flow_NotFulfilled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToValidate" sourceRef="StartEvent_OrderReceived" targetRef="Task_ValidateOrder" />
    <bpmn:sequenceFlow id="Flow_ToValidGateway" sourceRef="Task_ValidateOrder" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="Flow_Valid" name="valid" sourceRef="Gateway_Valid" targetRef="Task_CheckInventory">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Invalid" name="invalid" sourceRef="Gateway_Valid" targetRef="Gateway_MergeNotify" />
    <bpmn:sequenceFlow id="Flow_ToStockGateway" sourceRef="Task_CheckInventory" targetRef="Gateway_Stock" />
    <bpmn:sequenceFlow id="Flow_InStock" name="in stock" sourceRef="Gateway_Stock" targetRef="Task_CalculateTotal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OutOfStock" name="insufficient stock" sourceRef="Gateway_Stock" targetRef="Gateway_MergeNotify" />
    <bpmn:sequenceFlow id="Flow_ToPriority" sourceRef="Task_CalculateTotal" targetRef="Task_DeterminePriority" />
    <bpmn:sequenceFlow id="Flow_ToVerifyGateway" sourceRef="Task_DeterminePriority" targetRef="Gateway_NeedsVerification" />
    <bpmn:sequenceFlow id="Flow_NeedsVerification" name="yes" sourceRef="Gateway_NeedsVerification" targetRef="Task_VerifyOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=manualVerificationRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoVerification" name="no" sourceRef="Gateway_NeedsVerification" targetRef="Gateway_JoinPayment" />
    <bpmn:sequenceFlow id="Flow_ToVerifiedGateway" sourceRef="Task_VerifyOrder" targetRef="Gateway_Verified" />
    <bpmn:sequenceFlow id="Flow_VerificationApproved" name="approved" sourceRef="Gateway_Verified" targetRef="Gateway_JoinPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verificationDecision = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_VerificationRejected" name="rejected" sourceRef="Gateway_Verified" targetRef="Gateway_MergeNotify" />
    <bpmn:sequenceFlow id="Flow_ToPayment" sourceRef="Gateway_JoinPayment" targetRef="Task_ProcessPayment" />
    <bpmn:sequenceFlow id="Flow_ToPaymentGateway" sourceRef="Task_ProcessPayment" targetRef="Gateway_Payment" />
    <bpmn:sequenceFlow id="Flow_PaymentApproved" name="APPROVED" sourceRef="Gateway_Payment" targetRef="Task_ArrangeFulfilment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PaymentDeclined" name="DECLINED" sourceRef="Gateway_Payment" targetRef="Gateway_MergeNotify" />
    <bpmn:sequenceFlow id="Flow_FulfilmentToMerge" sourceRef="Task_ArrangeFulfilment" targetRef="Gateway_MergeNotify" />
    <bpmn:sequenceFlow id="Flow_ToNotify" sourceRef="Gateway_MergeNotify" targetRef="Task_NotifyCustomer" />
    <bpmn:sequenceFlow id="Flow_ToFinalGateway" sourceRef="Task_NotifyCustomer" targetRef="Gateway_Final" />
    <bpmn:sequenceFlow id="Flow_Fulfilled" name="FULFILMENT_SCHEDULED" sourceRef="Gateway_Final" targetRef="EndEvent_Fulfilled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderStatus = "FULFILMENT_SCHEDULED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotFulfilled" name="other" sourceRef="Gateway_Final" targetRef="EndEvent_NotFulfilled" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_OrderProcessing">
    <bpmndi:BPMNPlane id="BPMNPlane_OrderProcessing" bpmnElement="order-processing-process">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="StartEvent_OrderReceived">
        <dc:Bounds x="152" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="134" y="285" width="73" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Validate" bpmnElement="Task_ValidateOrder">
        <dc:Bounds x="230" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwValid" bpmnElement="Gateway_Valid" isMarkerVisible="true">
        <dc:Bounds x="385" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="380" y="205" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CheckInventory" bpmnElement="Task_CheckInventory">
        <dc:Bounds x="490" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwStock" bpmnElement="Gateway_Stock" isMarkerVisible="true">
        <dc:Bounds x="645" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="647" y="205" width="46" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CalcTotal" bpmnElement="Task_CalculateTotal">
        <dc:Bounds x="750" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Priority" bpmnElement="Task_DeterminePriority">
        <dc:Bounds x="910" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwNeedsVerification" bpmnElement="Gateway_NeedsVerification" isMarkerVisible="true">
        <dc:Bounds x="1065" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1045" y="192" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_VerifyOrder" bpmnElement="Task_VerifyOrder">
        <dc:Bounds x="1040" y="380" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwVerified" bpmnElement="Gateway_Verified" isMarkerVisible="true">
        <dc:Bounds x="1195" y="395" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1255" y="413" width="45" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwJoinPayment" bpmnElement="Gateway_JoinPayment" isMarkerVisible="true">
        <dc:Bounds x="1195" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Payment" bpmnElement="Task_ProcessPayment">
        <dc:Bounds x="1300" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwPayment" bpmnElement="Gateway_Payment" isMarkerVisible="true">
        <dc:Bounds x="1455" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1435" y="205" width="90" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Fulfilment" bpmnElement="Task_ArrangeFulfilment">
        <dc:Bounds x="1560" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwMergeNotify" bpmnElement="Gateway_MergeNotify" isMarkerVisible="true">
        <dc:Bounds x="1715" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Notify" bpmnElement="Task_NotifyCustomer">
        <dc:Bounds x="1820" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwFinal" bpmnElement="Gateway_Final" isMarkerVisible="true">
        <dc:Bounds x="1975" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="2035" y="253" width="66" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndFulfilled" bpmnElement="EndEvent_Fulfilled">
        <dc:Bounds x="2112" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2090" y="185" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndNotFulfilled" bpmnElement="EndEvent_NotFulfilled">
        <dc:Bounds x="2112" y="342" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2090" y="385" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_ToValidate" bpmnElement="Flow_ToValidate">
        <di:waypoint x="188" y="260" /><di:waypoint x="230" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToValidGateway" bpmnElement="Flow_ToValidGateway">
        <di:waypoint x="330" y="260" /><di:waypoint x="385" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Valid" bpmnElement="Flow_Valid">
        <di:waypoint x="435" y="260" /><di:waypoint x="490" y="260" />
        <bpmndi:BPMNLabel><dc:Bounds x="450" y="242" width="24" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Invalid" bpmnElement="Flow_Invalid">
        <di:waypoint x="410" y="285" /><di:waypoint x="410" y="580" /><di:waypoint x="1740" y="580" /><di:waypoint x="1740" y="285" />
        <bpmndi:BPMNLabel><dc:Bounds x="418" y="550" width="34" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToStockGateway" bpmnElement="Flow_ToStockGateway">
        <di:waypoint x="590" y="260" /><di:waypoint x="645" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_InStock" bpmnElement="Flow_InStock">
        <di:waypoint x="695" y="260" /><di:waypoint x="750" y="260" />
        <bpmndi:BPMNLabel><dc:Bounds x="700" y="242" width="40" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_OutOfStock" bpmnElement="Flow_OutOfStock">
        <di:waypoint x="670" y="285" /><di:waypoint x="670" y="540" /><di:waypoint x="1740" y="540" /><di:waypoint x="1740" y="285" />
        <bpmndi:BPMNLabel><dc:Bounds x="678" y="510" width="85" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToPriority" bpmnElement="Flow_ToPriority">
        <di:waypoint x="850" y="260" /><di:waypoint x="910" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToVerifyGateway" bpmnElement="Flow_ToVerifyGateway">
        <di:waypoint x="1010" y="260" /><di:waypoint x="1065" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_NeedsVerification" bpmnElement="Flow_NeedsVerification">
        <di:waypoint x="1090" y="285" /><di:waypoint x="1090" y="380" />
        <bpmndi:BPMNLabel><dc:Bounds x="1098" y="320" width="18" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_NoVerification" bpmnElement="Flow_NoVerification">
        <di:waypoint x="1115" y="260" /><di:waypoint x="1195" y="260" />
        <bpmndi:BPMNLabel><dc:Bounds x="1148" y="242" width="13" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToVerifiedGateway" bpmnElement="Flow_ToVerifiedGateway">
        <di:waypoint x="1140" y="420" /><di:waypoint x="1195" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_VerificationApproved" bpmnElement="Flow_VerificationApproved">
        <di:waypoint x="1220" y="395" /><di:waypoint x="1220" y="285" />
        <bpmndi:BPMNLabel><dc:Bounds x="1228" y="333" width="47" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_VerificationRejected" bpmnElement="Flow_VerificationRejected">
        <di:waypoint x="1220" y="445" /><di:waypoint x="1220" y="500" /><di:waypoint x="1740" y="500" /><di:waypoint x="1740" y="285" />
        <bpmndi:BPMNLabel><dc:Bounds x="1228" y="470" width="42" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToPayment" bpmnElement="Flow_ToPayment">
        <di:waypoint x="1245" y="260" /><di:waypoint x="1300" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToPaymentGateway" bpmnElement="Flow_ToPaymentGateway">
        <di:waypoint x="1400" y="260" /><di:waypoint x="1455" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_PaymentApproved" bpmnElement="Flow_PaymentApproved">
        <di:waypoint x="1505" y="260" /><di:waypoint x="1560" y="260" />
        <bpmndi:BPMNLabel><dc:Bounds x="1503" y="242" width="58" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_PaymentDeclined" bpmnElement="Flow_PaymentDeclined">
        <di:waypoint x="1480" y="285" /><di:waypoint x="1480" y="360" /><di:waypoint x="1740" y="360" /><di:waypoint x="1740" y="285" />
