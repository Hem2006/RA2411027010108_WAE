<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_HospitalTriage" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="hospital-triage-process" name="Lab 3 - Hospital Appointment and Triage" isExecutable="true">
    <bpmn:documentation>Educational simulation with synthetic patients only. Validate registration (job worker), triage (DMN), staff review / urgent assessment (user tasks), retrieve slots from the mock scheduling API (REST connector), book appointment and notify (job workers).</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Appointment request received">
      <bpmn:outgoing>Flow_ToValidate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ValidateRegistration" name="Validate registration">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lab3-validate-registration" retries="2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToValidGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Registration valid?" default="Flow_Invalid">
      <bpmn:incoming>Flow_ToValidGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_Triage" name="Triage request (DMN)">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="triage-category-decision" resultVariable="triageResult" />
        <zeebe:ioMapping>
          <zeebe:output source="=triageResult" target="triageResult" />
          <zeebe:output source="=triageResult.triageCategory" target="triageCategory" />
          <zeebe:output source="=triageResult.triageReason" target="triageReason" />
          <zeebe:output source="=triageResult.maxWaitDays" target="maxWaitDays" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTriageGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Triage" name="Triage category?" default="Flow_Routine">
      <bpmn:incoming>Flow_ToTriageGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Urgent</bpmn:outgoing>
      <bpmn:outgoing>Flow_Priority</bpmn:outgoing>
      <bpmn:outgoing>Flow_Routine</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_UrgentAssessment" name="Immediate clinical assessment">
      <bpmn:documentation>Simulated immediate human assessment by an authorised clinician.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="urgent-assessment-form" />
        <zeebe:assignmentDefinition candidateGroups="triage-clinicians" />
        <zeebe:priorityDefinition priority="100" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Urgent</bpmn:incoming>
      <bpmn:incoming>Flow_Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_UrgentToMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PriorityReview" name="Priority staff review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="priority-review-form" />
        <zeebe:assignmentDefinition candidateGroups="triage-nurses" />
        <zeebe:priorityDefinition priority="75" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Priority</bpmn:incoming>
      <bpmn:outgoing>Flow_ToStaffDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_StaffDecision" name="Staff decision?" default="Flow_ApproveScheduling">
      <bpmn:incoming>Flow_ToStaffDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ApproveScheduling</bpmn:outgoing>
      <bpmn:outgoing>Flow_Escalate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_JoinScheduling">
      <bpmn:incoming>Flow_Routine</bpmn:incoming>
      <bpmn:incoming>Flow_ApproveScheduling</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRetrieveSlots</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RetrieveSlots" name="Retrieve available slots (REST)" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="11">
      <bpmn:documentation>REST Connector: GET slots from the mock hospital scheduling API within the triage wait limit. HTTP 5xx: 3 connector retries, then an incident.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="{{secrets.LAB3_MOCK_API_URL}}/api/scheduling/slots" target="url" />
          <zeebe:input source="={&#34;Accept&#34;: &#34;application/json&#34;, &#34;X-Request-Id&#34;: requestId}" target="headers" />
          <zeebe:input source="={department: department, fromDate: preferredDate, timeOfDay: preferredTimeOfDay, withinDays: string(maxWaitDays)}" target="queryParameters" />
          <zeebe:input source="false" target="storeResponse" />
          <zeebe:input source="10" target="connectionTimeoutInSeconds" />
          <zeebe:input source="10" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="11" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={availableSlots: response.body.slots, slotCount: count(response.body.slots)}" />
          <zeebe:header key="retryBackoff" value="PT10S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRetrieveSlots</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSlotsGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Slots" name="Slot available?" default="Flow_NoSlots">
      <bpmn:incoming>Flow_ToSlotsGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_HasSlots</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoSlots</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_BookAppointment" name="Book appointment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lab3-book-appointment" retries="2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HasSlots</bpmn:incoming>
      <bpmn:outgoing>Flow_BookedToMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ManualScheduling" name="Manual scheduling review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="manual-scheduling-form" />
        <zeebe:assignmentDefinition candidateGroups="scheduling-staff" />
        <zeebe:priorityDefinition priority="50" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoSlots</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualToMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MergeNotify">
      <bpmn:incoming>Flow_BookedToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_ManualToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_UrgentToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNotify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NotifyPatient" name="Notify patient">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lab3-notify-patient" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFinalGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Final" name="Request status?" default="Flow_Other">
      <bpmn:incoming>Flow_ToFinalGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Booked</bpmn:outgoing>
      <bpmn:outgoing>Flow_Other</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Booked" name="Appointment booked">
      <bpmn:incoming>Flow_Booked</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_HandledByStaff" name="Request closed by staff / rejected">
      <bpmn:incoming>Flow_Other</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToValidate" sourceRef="StartEvent_RequestReceived" targetRef="Task_ValidateRegistration" />
    <bpmn:sequenceFlow id="Flow_ToValidGateway" sourceRef="Task_ValidateRegistration" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="Flow_Valid" name="valid" sourceRef="Gateway_Valid" targetRef="Task_Triage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=registrationValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Invalid" name="invalid" sourceRef="Gateway_Valid" targetRef="Gateway_MergeNotify" />
    <bpmn:sequenceFlow id="Flow_ToTriageGateway" sourceRef="Task_Triage" targetRef="Gateway_Triage" />
    <bpmn:sequenceFlow id="Flow_Urgent" name="URGENT_ASSESSMENT" sourceRef="Gateway_Triage" targetRef="Task_UrgentAssessment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=triageCategory = "URGENT_ASSESSMENT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Priority" name="PRIORITY_REVIEW" sourceRef="Gateway_Triage" targetRef="Task_PriorityReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=triageCategory = "PRIORITY_REVIEW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Routine" name="ROUTINE" sourceRef="Gateway_Triage" targetRef="Gateway_JoinScheduling" />
    <bpmn:sequenceFlow id="Flow_ToStaffDecision" sourceRef="Task_PriorityReview" targetRef="Gateway_StaffDecision" />
    <bpmn:sequenceFlow id="Flow_ApproveScheduling" name="schedule" sourceRef="Gateway_StaffDecision" targetRef="Gateway_JoinScheduling" />
    <bpmn:sequenceFlow id="Flow_Escalate" name="escalate" sourceRef="Gateway_StaffDecision" targetRef="Task_UrgentAssessment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=staffDecision = "ESCALATE_URGENT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToRetrieveSlots" sourceRef="Gateway_JoinScheduling" targetRef="Task_RetrieveSlots" />
    <bpmn:sequenceFlow id="Flow_ToSlotsGateway" sourceRef="Task_RetrieveSlots" targetRef="Gateway_Slots" />
    <bpmn:sequenceFlow id="Flow_HasSlots" name="yes" sourceRef="Gateway_Slots" targetRef="Task_BookAppointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoSlots" name="no suitable slot" sourceRef="Gateway_Slots" targetRef="Task_ManualScheduling" />
    <bpmn:sequenceFlow id="Flow_BookedToMerge" sourceRef="Task_BookAppointment" targetRef="Gateway_MergeNotify" />
    <bpmn:sequenceFlow id="Flow_ManualToMerge" sourceRef="Task_ManualScheduling" targetRef="Gateway_MergeNotify" />
    <bpmn:sequenceFlow id="Flow_UrgentToMerge" sourceRef="Task_UrgentAssessment" targetRef="Gateway_MergeNotify" />
    <bpmn:sequenceFlow id="Flow_ToNotify" sourceRef="Gateway_MergeNotify" targetRef="Task_NotifyPatient" />
    <bpmn:sequenceFlow id="Flow_ToFinalGateway" sourceRef="Task_NotifyPatient" targetRef="Gateway_Final" />
    <bpmn:sequenceFlow id="Flow_Booked" name="APPOINTMENT_BOOKED" sourceRef="Gateway_Final" targetRef="EndEvent_Booked">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requestStatus = "APPOINTMENT_BOOKED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Other" name="other" sourceRef="Gateway_Final" targetRef="EndEvent_HandledByStaff" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_HospitalTriage">
    <bpmndi:BPMNPlane id="BPMNPlane_HospitalTriage" bpmnElement="hospital-triage-process">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="StartEvent_RequestReceived">
        <dc:Bounds x="152" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="127" y="325" width="87" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Validate" bpmnElement="Task_ValidateRegistration">
        <dc:Bounds x="230" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwValid" bpmnElement="Gateway_Valid" isMarkerVisible="true">
        <dc:Bounds x="385" y="275" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="365" y="245" width="90" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Triage" bpmnElement="Task_Triage">
        <dc:Bounds x="490" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwTriage" bpmnElement="Gateway_Triage" isMarkerVisible="true">
        <dc:Bounds x="645" y="275" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="560" y="225" width="82" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Urgent" bpmnElement="Task_UrgentAssessment">
        <dc:Bounds x="870" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PriorityReview" bpmnElement="Task_PriorityReview">
        <dc:Bounds x="770" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwStaffDecision" bpmnElement="Gateway_StaffDecision" isMarkerVisible="true">
        <dc:Bounds x="895" y="415" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="882" y="472" width="76" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwJoinScheduling" bpmnElement="Gateway_JoinScheduling" isMarkerVisible="true">
        <dc:Bounds x="1035" y="275" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_RetrieveSlots" bpmnElement="Task_RetrieveSlots">
        <dc:Bounds x="1120" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwSlots" bpmnElement="Gateway_Slots" isMarkerVisible="true">
        <dc:Bounds x="1275" y="275" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1263" y="245" width="74" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Book" bpmnElement="Task_BookAppointment">
        <dc:Bounds x="1380" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ManualScheduling" bpmnElement="Task_ManualScheduling">
        <dc:Bounds x="1380" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwMergeNotify" bpmnElement="Gateway_MergeNotify" isMarkerVisible="true">
        <dc:Bounds x="1535" y="275" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Notify" bpmnElement="Task_NotifyPatient">
        <dc:Bounds x="1640" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwFinal" bpmnElement="Gateway_Final" isMarkerVisible="true">
        <dc:Bounds x="1795" y="275" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1855" y="293" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndBooked" bpmnElement="EndEvent_Booked">
        <dc:Bounds x="1932" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1915" y="225" width="70" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndHandled" bpmnElement="EndEvent_HandledByStaff">
        <dc:Bounds x="1932" y="382" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1905" y="425" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_ToValidate" bpmnElement="Flow_ToValidate">
        <di:waypoint x="188" y="300" /><di:waypoint x="230" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToValidGateway" bpmnElement="Flow_ToValidGateway">
        <di:waypoint x="330" y="300" /><di:waypoint x="385" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Valid" bpmnElement="Flow_Valid">
        <di:waypoint x="435" y="300" /><di:waypoint x="490" y="300" />
        <bpmndi:BPMNLabel><dc:Bounds x="450" y="282" width="24" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Invalid" bpmnElement="Flow_Invalid">
        <di:waypoint x="410" y="325" /><di:waypoint x="410" y="580" /><di:waypoint x="1560" y="580" /><di:waypoint x="1560" y="325" />
        <bpmndi:BPMNLabel><dc:Bounds x="418" y="550" width="34" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToTriageGateway" bpmnElement="Flow_ToTriageGateway">
        <di:waypoint x="590" y="300" /><di:waypoint x="645" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Urgent" bpmnElement="Flow_Urgent">
        <di:waypoint x="670" y="275" /><di:waypoint x="670" y="140" /><di:waypoint x="870" y="140" />
        <bpmndi:BPMNLabel><dc:Bounds x="685" y="122" width="125" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Priority" bpmnElement="Flow_Priority">
        <di:waypoint x="670" y="325" /><di:waypoint x="670" y="440" /><di:waypoint x="770" y="440" />
        <bpmndi:BPMNLabel><dc:Bounds x="660" y="450" width="100" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Routine" bpmnElement="Flow_Routine">
        <di:waypoint x="695" y="300" /><di:waypoint x="1035" y="300" />
        <bpmndi:BPMNLabel><dc:Bounds x="725" y="282" width="50" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToStaffDecision" bpmnElement="Flow_ToStaffDecision">
        <di:waypoint x="870" y="440" /><di:waypoint x="895" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ApproveScheduling" bpmnElement="Flow_ApproveScheduling">
        <di:waypoint x="945" y="440" /><di:waypoint x="1060" y="440" /><di:waypoint x="1060" y="325" />
        <bpmndi:BPMNLabel><dc:Bounds x="975" y="422" width="45" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Escalate" bpmnElement="Flow_Escalate">
        <di:waypoint x="920" y="415" /><di:waypoint x="920" y="180" />
        <bpmndi:BPMNLabel><dc:Bounds x="928" y="350" width="44" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToRetrieveSlots" bpmnElement="Flow_ToRetrieveSlots">
        <di:waypoint x="1085" y="300" /><di:waypoint x="1120" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToSlotsGateway" bpmnElement="Flow_ToSlotsGateway">
        <di:waypoint x="1220" y="300" /><di:waypoint x="1275" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_HasSlots" bpmnElement="Flow_HasSlots">
        <di:waypoint x="1325" y="300" /><di:waypoint x="1380" y="300" />
        <bpmndi:BPMNLabel><dc:Bounds x="1343" y="282" width="18" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_NoSlots" bpmnElement="Flow_NoSlots">
        <di:waypoint x="1300" y="325" /><di:waypoint x="1300" y="440" /><di:waypoint x="1380" y="440" />
        <bpmndi:BPMNLabel><dc:Bounds x="1225" y="450" width="75" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_BookedToMerge" bpmnElement="Flow_BookedToMerge">
        <di:waypoint x="1480" y="300" /><di:waypoint x="1535" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ManualToMerge" bpmnElement="Flow_ManualToMerge">
        <di:waypoint x="1480" y="440" /><di:waypoint x="1560" y="440" /><di:waypoint x="1560" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_UrgentToMerge" bpmnElement="Flow_UrgentToMerge">
        <di:waypoint x="970" y="140" /><di:waypoint x="1560" y="140" /><di:waypoint x="1560" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToNotify" bpmnElement="Flow_ToNotify">
        <di:waypoint x="1585" y="300" /><di:waypoint x="1640" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToFinalGateway" bpmnElement="Flow_ToFinalGateway">
        <di:waypoint x="1740" y="300" /><di:waypoint x="1795" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Booked" bpmnElement="Flow_Booked">
