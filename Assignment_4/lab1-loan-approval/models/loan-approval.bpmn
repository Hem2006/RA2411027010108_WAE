<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LoanApproval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:error id="Error_CreditApi" name="Credit API error" errorCode="CREDIT_API_ERROR" />
  <bpmn:process id="loan-approval-process" name="Lab 1 - Loan Approval" isExecutable="true">
    <bpmn:documentation>End-to-end loan approval: validate applicant (job worker), assess credit (REST connector), classify (DMN), manual review (user task), notify applicant (job worker).</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_ApplicationReceived" name="Loan application received">
      <bpmn:outgoing>Flow_ToValidate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ValidateApplicant" name="Validate applicant">
      <bpmn:documentation>External Spring Boot job worker. Business-rule problems set validationPassed=false; technically unreadable data (e.g. non-numeric monthlyIncome) fails the job and raises an incident.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lab1-validate-applicant" retries="2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToValidGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Applicant valid?" default="Flow_Invalid">
      <bpmn:incoming>Flow_ToValidGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AssessCredit" name="Assess credit (REST)" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="11">
      <bpmn:documentation>REST Connector calling the mock credit-assessment API. Any HTTP error or timeout is mapped to BPMN error CREDIT_API_ERROR and routed to manual review.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="{{secrets.LAB1_MOCK_API_URL}}/api/credit/assessments" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;: &#34;application/json&#34;, &#34;X-Correlation-Id&#34;: applicationId}" target="headers" />
          <zeebe:input source="false" target="storeResponse" />
          <zeebe:input source="10" target="connectionTimeoutInSeconds" />
          <zeebe:input source="10" target="readTimeoutInSeconds" />
          <zeebe:input source="={applicationId: applicationId, applicantId: applicantId, applicantName: applicantName, loanAmount: loanAmount, monthlyIncome: monthlyIncome, monthlyDebt: monthlyDebt}" target="body" />
          <zeebe:input source="false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="11" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={creditScore: response.body.creditScore, creditRiskBand: response.body.riskBand, creditAssessmentId: response.body.assessmentId, existingDefaults: response.body.existingDefaults}" />
          <zeebe:header key="errorExpression" value="=if error != null then bpmnError(&#34;CREDIT_API_ERROR&#34;, &#34;Credit assessment API error or timeout&#34;) else null" />
          <zeebe:header key="retryBackoff" value="PT5S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDecision</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Event_CreditApiError" name="Credit API error / timeout" attachedToRef="Task_AssessCredit">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;CREDIT_SERVICE_UNAVAILABLE&#34;" target="reviewReason" />
          <zeebe:output source="=&#34;MANUAL_REVIEW&#34;" target="loanDecision" />
          <zeebe:output source="=&#34;Credit assessment could not be completed (API error or timeout)&#34;" target="decisionReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_CreditErrorToReview</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_CreditApi" errorRef="Error_CreditApi" />
    </bpmn:boundaryEvent>
    <bpmn:businessRuleTask id="Task_LoanDecision" name="Determine loan decision (DMN)">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="loan-eligibility-decision" resultVariable="loanDecisionResult" />
        <zeebe:ioMapping>
          <zeebe:output source="=loanDecisionResult" target="loanDecisionResult" />
          <zeebe:output source="=loanDecisionResult.decision" target="loanDecision" />
          <zeebe:output source="=loanDecisionResult.reason" target="decisionReason" />
          <zeebe:output source="=if loanDecisionResult.decision = &#34;MANUAL_REVIEW&#34; then &#34;DMN_MANUAL_REVIEW&#34; else null" target="reviewReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDecisionGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Loan decision?" default="Flow_NeedsReview">
      <bpmn:incoming>Flow_ToDecisionGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_AutoRejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_NeedsReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ManualReview" name="Review loan application">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="loan-review-form" />
        <zeebe:assignmentDefinition candidateGroups="loan-officers" />
        <zeebe:priorityDefinition priority="60" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NeedsReview</bpmn:incoming>
      <bpmn:incoming>Flow_CreditErrorToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Merge">
      <bpmn:incoming>Flow_AutoApproved</bpmn:incoming>
      <bpmn:incoming>Flow_AutoRejected</bpmn:incoming>
      <bpmn:incoming>Flow_ReviewDone</bpmn:incoming>
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNotify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NotifyApplicant" name="Notify applicant">
      <bpmn:documentation>External job worker. Computes finalStatus/finalReason from validation, DMN and review results and sends a simulated notification.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lab1-notify-applicant" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFinalGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Final" name="Final status?" default="Flow_FinalRejected">
      <bpmn:incoming>Flow_ToFinalGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_FinalRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Approved" name="Loan approved">
      <bpmn:incoming>Flow_FinalApproved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Rejected" name="Loan rejected">
      <bpmn:incoming>Flow_FinalRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToValidate" sourceRef="StartEvent_ApplicationReceived" targetRef="Task_ValidateApplicant" />
    <bpmn:sequenceFlow id="Flow_ToValidGateway" sourceRef="Task_ValidateApplicant" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="Flow_Valid" name="valid" sourceRef="Gateway_Valid" targetRef="Task_AssessCredit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=validationPassed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Invalid" name="invalid" sourceRef="Gateway_Valid" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_ToDecision" sourceRef="Task_AssessCredit" targetRef="Task_LoanDecision" />
    <bpmn:sequenceFlow id="Flow_CreditErrorToReview" sourceRef="Event_CreditApiError" targetRef="Task_ManualReview" />
    <bpmn:sequenceFlow id="Flow_ToDecisionGateway" sourceRef="Task_LoanDecision" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_AutoApproved" name="APPROVED" sourceRef="Gateway_Decision" targetRef="Gateway_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loanDecision = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AutoRejected" name="REJECTED" sourceRef="Gateway_Decision" targetRef="Gateway_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loanDecision = "REJECTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NeedsReview" name="MANUAL_REVIEW" sourceRef="Gateway_Decision" targetRef="Task_ManualReview" />
    <bpmn:sequenceFlow id="Flow_ReviewDone" sourceRef="Task_ManualReview" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_ToNotify" sourceRef="Gateway_Merge" targetRef="Task_NotifyApplicant" />
    <bpmn:sequenceFlow id="Flow_ToFinalGateway" sourceRef="Task_NotifyApplicant" targetRef="Gateway_Final" />
    <bpmn:sequenceFlow id="Flow_FinalApproved" name="APPROVED" sourceRef="Gateway_Final" targetRef="EndEvent_Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=finalStatus = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FinalRejected" name="REJECTED" sourceRef="Gateway_Final" targetRef="EndEvent_Rejected" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_LoanApproval">
    <bpmndi:BPMNPlane id="BPMNPlane_LoanApproval" bpmnElement="loan-approval-process">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="StartEvent_ApplicationReceived">
        <dc:Bounds x="152" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="130" y="265" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Validate" bpmnElement="Task_ValidateApplicant">
        <dc:Bounds x="240" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwValid" bpmnElement="Gateway_Valid" isMarkerVisible="true">
        <dc:Bounds x="395" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="380" y="185" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_AssessCredit" bpmnElement="Task_AssessCredit">
        <dc:Bounds x="500" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_LoanDecision" bpmnElement="Task_LoanDecision">
        <dc:Bounds x="660" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwDecision" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <dc:Bounds x="815" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="755" y="272" width="75" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ManualReview" bpmnElement="Task_ManualReview">
        <dc:Bounds x="930" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwMerge" bpmnElement="Gateway_Merge" isMarkerVisible="true">
        <dc:Bounds x="1085" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Notify" bpmnElement="Task_NotifyApplicant">
        <dc:Bounds x="1190" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GwFinal" bpmnElement="Gateway_Final" isMarkerVisible="true">
        <dc:Bounds x="1345" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1405" y="233" width="62" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndApproved" bpmnElement="EndEvent_Approved">
        <dc:Bounds x="1472" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1455" y="165" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndRejected" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="1472" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1457" y="365" width="67" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CreditError" bpmnElement="Event_CreditApiError">
        <dc:Bounds x="532" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="465" y="300" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_ToValidate" bpmnElement="Flow_ToValidate">
        <di:waypoint x="188" y="240" /><di:waypoint x="240" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToValidGateway" bpmnElement="Flow_ToValidGateway">
        <di:waypoint x="340" y="240" /><di:waypoint x="395" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Valid" bpmnElement="Flow_Valid">
        <di:waypoint x="445" y="240" /><di:waypoint x="500" y="240" />
        <bpmndi:BPMNLabel><dc:Bounds x="460" y="222" width="24" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Invalid" bpmnElement="Flow_Invalid">
        <di:waypoint x="420" y="265" /><di:waypoint x="420" y="440" /><di:waypoint x="1110" y="440" /><di:waypoint x="1110" y="265" />
        <bpmndi:BPMNLabel><dc:Bounds x="428" y="400" width="34" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToDecision" bpmnElement="Flow_ToDecision">
        <di:waypoint x="600" y="240" /><di:waypoint x="660" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_CreditErrorToReview" bpmnElement="Flow_CreditErrorToReview">
        <di:waypoint x="550" y="298" /><di:waypoint x="550" y="330" /><di:waypoint x="980" y="330" /><di:waypoint x="980" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToDecisionGateway" bpmnElement="Flow_ToDecisionGateway">
        <di:waypoint x="760" y="240" /><di:waypoint x="815" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_AutoApproved" bpmnElement="Flow_AutoApproved">
        <di:waypoint x="840" y="215" /><di:waypoint x="840" y="110" /><di:waypoint x="1110" y="110" /><di:waypoint x="1110" y="215" />
        <bpmndi:BPMNLabel><dc:Bounds x="945" y="92" width="58" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_AutoRejected" bpmnElement="Flow_AutoRejected">
        <di:waypoint x="840" y="265" /><di:waypoint x="840" y="380" /><di:waypoint x="1110" y="380" /><di:waypoint x="1110" y="265" />
        <bpmndi:BPMNLabel><dc:Bounds x="945" y="362" width="57" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_NeedsReview" bpmnElement="Flow_NeedsReview">
        <di:waypoint x="865" y="240" /><di:waypoint x="930" y="240" />
        <bpmndi:BPMNLabel><dc:Bounds x="855" y="250" width="90" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ReviewDone" bpmnElement="Flow_ReviewDone">
        <di:waypoint x="1030" y="240" /><di:waypoint x="1085" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToNotify" bpmnElement="Flow_ToNotify">
        <di:waypoint x="1135" y="240" /><di:waypoint x="1190" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToFinalGateway" bpmnElement="Flow_ToFinalGateway">
        <di:waypoint x="1290" y="240" /><di:waypoint x="1345" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_FinalApproved" bpmnElement="Flow_FinalApproved">
        <di:waypoint x="1370" y="215" /><di:waypoint x="1370" y="140" /><di:waypoint x="1472" y="140" />
        <bpmndi:BPMNLabel><dc:Bounds x="1385" y="122" width="58" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_FinalRejected" bpmnElement="Flow_FinalRejected">
        <di:waypoint x="1370" y="265" /><di:waypoint x="1370" y="340" /><di:waypoint x="1472" y="340" />
        <bpmndi:BPMNLabel><dc:Bounds x="1385" y="322" width="57" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
